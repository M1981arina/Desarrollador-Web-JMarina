<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Arenillas Vuelve a Brillar</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- Esta sección podría convertirse posteriormente en base.html -->
<header>
    <h1>Arenillas Vuelve a Brillar</h1>
</header>


<!-- Esta sección podría convertirse posteriormente en base.html -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container">
        <a class="navbar-brand" href="#">GAD Arenillas</a>
    </div>
</nav>


<main class="container mt-4">

    <h2>Registro de Obras Municipales</h2>


    <form id="formObra">

        <input 
        type="text" 
        id="nombreObra"
        class="form-control mb-2"
        placeholder="Nombre de la obra">


        <textarea
        id="descripcionObra"
        class="form-control mb-2"
        placeholder="Descripción">
        </textarea>


        <input 
        type="text"
        id="tipoObra"
        class="form-control mb-2"
        placeholder="Tipo de obra">


        <button class="btn btn-success">
            Registrar
        </button>

    </form>


    <div id="mensaje" class="mt-3"></div>


    <h3 class="mt-4">
        Obras registradas:
        <span id="totalObras">0</span>
    </h3>


    <!-- Contenido generado dinámicamente desde JavaScript -->
    <div id="listaObras" class="row"></div>


</main>


<!-- Esta sección podría convertirse posteriormente en base.html -->
<footer class="bg-dark text-white text-center p-3 mt-5">

    © 2026 GAD Municipal Arenillas

</footer>


<script src="script.js"></script>

</body>
</html>



