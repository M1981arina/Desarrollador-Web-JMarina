</nav>

<main class="container my-4">

    <section id="inicio" class="card shadow p-4 mb-4">
        <h2>Bienvenido a Arenillas Vuelve a Brillar</h2>
        <p>Esta plataforma está diseñada para facilitar la administración y seguimiento de las obras realizadas en la ciudad.</p>
    </section>

    <section id="quienes-somos" class="card shadow p-4 mb-4">
        <h2>Quiénes Somos</h2>
        <p>Proyecto impulsado para mejorar la infraestructura y servicios de la ciudad de Arenillas.</p>
    </section>

    <section id="servicios" class="card shadow p-4 mb-4">
        <h2>Servicios</h2>

        <ul class="list-group">
            <li class="list-group-item">Administración de Obras Públicas</li>
            <li class="list-group-item">Transparencia en la Gestión Municipal</li>
            <li class="list-group-item">Comunicación con la Ciudadanía</li>
        </ul>
    </section>

    <section id="contacto" class="card shadow p-4 mb-4">
        <h2>Contacto</h2>
        <p><strong>Correo:</strong> arenillasbrilla@correo.com</p>
        <p><strong>Teléfono:</strong> 0969280318</p>
        <p><strong>Dirección:</strong> Avda José Moncada, Arenillas, Ecuador</p>

        <a href="https://www.facebook.com" class="btn btn-primary me-2" target="_blank">
            Facebook
        </a>

        <a href="https://www.twitter.com" class="btn btn-info text-white" target="_blank">
            Twitter
        </a>
    </section>

    <section id="registro-obras" class="card shadow p-4 mb-4">
        <h2>Registro de Obras Municipales</h2>

        <form id="formObra">

            <div class="mb-3">
                <label class="form-label">Nombre de la obra</label>
                <input type="text" id="nombreObra" class="form-control">
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea id="descripcionObra" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de obra</label>
                <input type="text" id="tipoObra" class="form-control">
            </div>

            <button type="submit" class="btn btn-success">
                Registrar Obra
            </button>
        </form>

        <div id="mensaje" class="mt-3"></div>

        <h4 class="mt-4">
            Total de obras registradas:
            <span id="totalObras" class="badge bg-primary">0</span>
        </h4>

        <div id="listaObras" class="mt-4"></div>
    </section>

